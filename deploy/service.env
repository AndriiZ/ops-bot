# ops-bot by the standard of services (README.md §2). setup.sh installs this file as /opt/ops-bot/configs/service.env.
TITLE=ops-bot
UNIT=ops-bot
SERVICE_USER=ops-bot
ENTRY=OpsBot
HEALTH_URL=http://127.0.0.1:8095/health
VERSION_URL=http://127.0.0.1:8095/health
HEALTH_TIMEOUT=60
KEEP_PREVIOUS=2
CONFIG_LINKS=appsettings.Production.json
