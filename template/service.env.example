# The parameters of deploy.sh and ops-bot for one service: /opt/<id>/configs/service.env.
# The file is data, not a shell script: KEY=VALUE, no quotes, no expansion. Mode 644: ops-bot reads it.

# The name in ops-bot.
TITLE=Demo service
# The systemd unit (without .service). Default: the id of the service.
UNIT=demo
# The system user of the service. It only reads the releases and configs/, and writes data/.
SERVICE_USER=demo
# The file that each release must have, relative to the release; deploy.sh makes it executable.
ENTRY=Demo
# The smoke test after the switch and the monitoring of ops-bot: the address must give 2xx.
HEALTH_URL=http://127.0.0.1:8090/health
# Optional: the answer of this address must contain "version":"<VERSION>" of the active release.
VERSION_URL=http://127.0.0.1:8090/health
# Seconds for the smoke test.
HEALTH_TIMEOUT=60
# The number of previous releases on the disk.
KEEP_PREVIOUS=2
# The files of configs/ that each release gets as links, separated by spaces.
CONFIG_LINKS=appsettings.Production.json
